# n8n Environment Variables
# Copy this file to .env and update with your values

# Domain Configuration (required)
DOMAIN=yourdomain.com

# n8n Host Configuration (required)
# Main UI subdomain
N8N_HOST=n8n.${DOMAIN}

# Webhook URL (separate subdomain for webhooks)
# Mapped to N8N_WEBHOOK_URL in docker-compose.yml; update-domain.sh rewrites this key.
WEBHOOK_URL=https://webhook.${DOMAIN}

